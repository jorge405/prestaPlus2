# Dependencias de Node (son muy pesadas y se reinstalan con npm install)
node_modules/

# Carpeta de producción (el resultado de compilar tu app con 'npm run build')
dist/

# Archivos de logs de errores de los gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos de entorno local (contienen credenciales, tokens o contraseñas secretas)
.env.local
.env.*.local

# Archivos de configuración de editores de código (opcional, pero recomendado)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos del sistema operativo
.DS_Store
Thumbs.db
